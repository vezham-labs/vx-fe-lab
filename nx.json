{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "timeline",
  "useDaemonProcess": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/vitest.config.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/packages/vx/styles/**/*"]
  },
  "nxCloudId": "6add54f5c6219b46c1c5863c",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/react/router-plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start",
        "watchDepsTargetName": "watch-deps",
        "buildDepsTargetName": "build-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    },
    "@vx-cli/react"
  ],
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/vx/tools/eslint/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "options": {
        "args": "--config \"$(git rev-parse --show-toplevel)/vitest.config.ts\""
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/vx/__tests__/**/*",
        {
          "externalDependencies": ["vitest", "@vezham/config"]
        },
        {
          "fileset": "{projectRoot}/tsconfig.spec.json",
          "dependencies": true
        },
        {
          "fileset": "{projectRoot}/tsconfig.storybook.json",
          "dependencies": true
        },
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        }
      ]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "hosts:setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "NAME=${name:-{projectName}} && sudo pnpm exec hostile set localhost $NAME.vezham.local && sudo pnpm exec hostile set localhost $NAME.mock.vezham.local"
      }
    },
    "routes:tanstack": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsr generate"
      }
    },
    "routes:tanstack:watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsr watch"
      }
    },
    "metadata:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vezham-metadata generate {projectRoot}"
      }
    },
    "deploy:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/vx.app.yaml",
        "{projectRoot}/vx.deploy.yaml",
        {
          "externalDependencies": ["@vezham/config"]
        }
      ],
      "outputs": [
        "{workspaceRoot}/vx/deploy/firebase/{projectRoot}.json",
        "{workspaceRoot}/vx/deploy/vercel/{projectRoot}.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vezham-deploy generate {projectRoot}"
      }
    },
    "metadata:watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vezham-metadata watch {projectRoot}"
      }
    },
    "openapi:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/vx.app.yaml",
        "{projectRoot}/content/docs/**/*",
        "{projectRoot}/openapi.yaml",
        "{projectRoot}/openapi/**/*",
        {
          "externalDependencies": ["@vezham/config"]
        }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vezham-docs generate {projectRoot}"
      }
    },
    "og:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["openapi:generate"],
      "inputs": [
        "{projectRoot}/vx.app.yaml",
        "{projectRoot}/content/**/*",
        "{projectRoot}/openapi.yaml",
        "{projectRoot}/openapi/**/*",
        "{projectRoot}/public/**/*",
        "!{projectRoot}/public/og/**/*",
        {
          "externalDependencies": [
            "@vercel/og",
            "@fontsource/inter",
            "@fontsource/jura",
            "@vezham/icons-react",
            "@vezham/config"
          ]
        }
      ],
      "outputs": ["{projectRoot}/public/og"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vezham-docs og {projectRoot}"
      }
    },
    "serve:next": {
      "executor": "nx:run-commands",
      "dependsOn": ["metadata:watch"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "{workspaceRoot}/vx/bin/next/server.sh {projectRoot}"
      }
    },
    "preview:next": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "pnpm exec nx run {projectName}:build",
          "{workspaceRoot}/vx/bin/next/server.sh {projectRoot} start"
        ],
        "parallel": false
      }
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "release": {
    "projects": ["*", "!@vx/fe-kit"],
    "version": {
      "preVersionCommand": "pnpm nx run @vx:@vx-ci/build",
      "conventionalCommits": true,
      "versionActions": "./vx/tools/release/version-actions.cjs"
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor"
        },
        "fix": {
          "semverBump": "patch"
        },
        "refactor": true,
        "mocks": true,
        "stories": true,
        "test": true,
        "docs": true,
        "i18n": true,
        "ci": true,
        "chore": true,
        "deps": true,
        "build": {
          "semverBump": "none"
        },
        "release": {
          "semverBump": "none"
        },
        "style": true,
        "perf": true,
        "revert": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    },
    "releaseTag": {
      "pattern": "{version}",
      "strictPreid": false
    }
  },
  "analytics": false,
  "affected": {
    "legacy": true
  }
}
