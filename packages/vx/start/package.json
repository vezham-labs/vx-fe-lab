      "default": "./src/lib/pages/docs/openapi/index.tsx"
    },
    "./pages/docs/route": {
      "types": "./src/lib/pages/docs/route/index.tsx",
      "import": "./src/lib/pages/docs/route/index.tsx",
      "default": "./src/lib/pages/docs/route/index.tsx"
    },
    "./runtime/*": {
      "types": "./src/lib/runtime/*/index.ts",
      "import": "./src/lib/runtime/*/index.ts",
      "default": "./src/lib/runtime/*/index.ts"
    },
    "./mdx": {
      "types": "./src/lib/mdx/index.tsx",
      "import": "./src/lib/mdx/index.tsx",
      "default": "./src/lib/mdx/index.tsx"
    },
    "./story": {
      "types": "./src/lib/story/index.ts",
      "import": "./src/lib/story/index.ts",
      "default": "./src/lib/story/index.ts"
    }
  },
  "dependencies": {
    "@vx/template": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@vx/devtools": "workspace:*",
    "@vx/env": "workspace:*"
  }
}
