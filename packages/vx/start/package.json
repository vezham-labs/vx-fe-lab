{
  "name": "@vx/start",
  "version": "26.0.0-alpha.1",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./vite": {
      "types": "./src/lib/provider/vite/index.tsx",
      "import": "./src/lib/provider/vite/index.tsx",
      "default": "./src/lib/provider/vite/index.tsx"
    },
    "./tanstack": {
      "types": "./src/lib/provider/tanstack/index.tsx",
      "import": "./src/lib/provider/tanstack/index.tsx",
      "default": "./src/lib/provider/tanstack/index.tsx"
    },
    "./tanstack-docs": {
      "types": "./src/lib/provider/tanstack-docs/index.tsx",
      "import": "./src/lib/provider/tanstack-docs/index.tsx",
      "default": "./src/lib/provider/tanstack-docs/index.tsx"
    },
    "./next": {
      "types": "./src/lib/provider/next/index.tsx",
      "import": "./src/lib/provider/next/index.tsx",
      "default": "./src/lib/provider/next/index.tsx"
    },
    "./router/tanstack": {
      "types": "./src/lib/router/tanstack/index.tsx",
      "import": "./src/lib/router/tanstack/index.tsx",
      "default": "./src/lib/router/tanstack/index.tsx"
    },
    "./layouts/*": {
      "types": "./src/lib/layouts/*/index.tsx",
      "import": "./src/lib/layouts/*/index.tsx",
      "default": "./src/lib/layouts/*/index.tsx"
    },
    "./pages/docs/openapi": {
      "types": "./src/lib/pages/docs/openapi/index.tsx",
